# データベース設定
DATABASE_URL="postgresql://postgres:password@localhost:5432/capu_db"

# NextAuth.js共通設定
NEXTAUTH_SECRET="your-nextauth-secret-here"

# キャストアプリ用環境変数
CAST_NEXTAUTH_URL="http://localhost:3000"
CAST_DISCORD_CLIENT_ID="your-discord-client-id"
CAST_DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ゲストアプリ用環境変数
GUEST_NEXTAUTH_URL="http://localhost:3001"
GUEST_LINE_CLIENT_ID="your-line-channel-id"
GUEST_LINE_CLIENT_SECRET="your-line-channel-secret"

# Stripe決済設定
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"

# Cloudflare R2ストレージ設定
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="your-r2-public-url"

# WebSocket設定
WEBSOCKET_PORT="3002"