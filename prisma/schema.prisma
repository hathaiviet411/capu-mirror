generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  emailVerified           DateTime?
  userType               UserType                @default(GUEST)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  birthDate              DateTime?
  city                   String?
  image                  String?
  isVerified             Boolean                 @default(false)
  name                   String?
  phoneNumber            String?
  points                 Int                     @default(0)
  prefecture             String?
  selfIntro              String?
  tags                   String[]
  accounts               Account[]
  sessions               Session[]
  activityLogs           ActivityLog[]
  bankAccounts           BankAccount[]
  castBookings           Booking[]               @relation("BookingCast")
  guestBookings          Booking[]               @relation("BookingGuest")
  castProfile            CastProfile?
  deviceTokens           DeviceToken[]
  favorites              Favorite[]
  files                  File[]
  guestProfile           GuestProfile?
  helpArticleRatings     HelpArticleRating[]
  idVerifications        IdVerification[]
  inquiries              Inquiry[]
  messageReactions       MessageReaction[]
  messageReadStatus      MessageReadStatus[]
  sentMessages           Message[]               @relation("MessageSender")
  newsReadStatus         NewsReadStatus[]
  notificationSettings   NotificationSetting[]
  notifications          Notification[]
  paymentMethods         PaymentMethod[]
  payments               Payment[]               @relation("PaymentPayer")
  payouts                Payout[]                @relation("PayoutCast")
  pinnedThreads          PinnedThread[]
  pointTransactions      PointTransaction[]
  privacySettings        PrivacySetting?
  profileViewsReceived   ProfileView[]           @relation("ProfileViewViewed")
  profileViewsGiven      ProfileView[]           @relation("ProfileViewViewer")
  reports                Report[]
  reviews                Review[]
  scheduleProposals      ScheduleProposal[]
  scheduledNotifications ScheduledNotification[]
  searchHistory          SearchHistory[]
  securityLogs           SecurityLog[]
  blockedBy              UserBlock[]             @relation("UserBlockBlocked")
  blockedUsers           UserBlock[]             @relation("UserBlockBlocker")
  reportsReceived        UserReport[]            @relation("UserReportReported")
  reportsSubmitted       UserReport[]            @relation("UserReportReporter")
  withdrawalRequests     WithdrawalRequest[]
  conversations          Conversation[]          @relation("ConversationToUser")

  @@index([email])
  @@index([userType])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CastProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  displayName  String
  bio          String?
  avatar       String?
  coverImage   String?
  hourlyRate   Int
  availability Json
  specialties  String[]
  experience   String?
  portfolio    Json?
  isActive     Boolean    @default(true)
  isVerified   Boolean    @default(false)
  areaId       String?
  categoryId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  area         Area?      @relation(fields: [areaId], references: [id])
  category     Category?  @relation(fields: [categoryId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites    Favorite[]
  reviews      Review[]   @relation("ReviewCast")
  tags         Tag[]      @relation("CastProfileToTag")

  @@index([isActive, isVerified])
  @@index([hourlyRate])
  @@index([areaId, categoryId])
  @@index([displayName])
  @@index([createdAt])
  @@map("cast_profiles")
}

model GuestProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  preferences Json?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews     Review[] @relation("ReviewGuest")

  @@map("guest_profiles")
}

model Booking {
  id              String        @id @default(cuid())
  guestId         String
  castId          String
  title           String
  description     String?
  serviceType     String
  startDateTime   DateTime
  endDateTime     DateTime
  durationMinutes Int
  hourlyRate      Int
  totalAmount     Int
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cast            User          @relation("BookingCast", fields: [castId], references: [id])
  guest           User          @relation("BookingGuest", fields: [guestId], references: [id])
  conversation    Conversation?
  payment         Payment?
  review          Review?

  @@index([guestId, status])
  @@index([castId, status])
  @@index([startDateTime, endDateTime])
  @@index([status, createdAt])
  @@map("bookings")
}

model Conversation {
  id                String             @id @default(cuid())
  bookingId         String?            @unique
  title             String?
  isGroup           Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  messages          Message[]
  pinnedThreads     PinnedThread[]
  scheduleProposals ScheduleProposal[]
  participants      User[]             @relation("ConversationToUser")

  @@map("conversations")
}

model Message {
  id                String              @id @default(cuid())
  conversationId    String
  senderId          String
  content           String?
  messageType       MessageType         @default(TEXT)
  isRead            Boolean             @default(false)
  isDeleted         Boolean             @default(false)
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  attachments       MessageAttachment[]
  reactions         MessageReaction[]
  messageReadStatus MessageReadStatus[]
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User                @relation("MessageSender", fields: [senderId], references: [id])
  pinnedThreads     PinnedThread[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([isRead])
  @@index([messageType])
  @@map("messages")
}

model MessageAttachment {
  id           String   @id @default(cuid())
  messageId    String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageReadStatus {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@map("message_read_status")
}

model Area {
  id           String        @id @default(cuid())
  name         String
  nameEn       String?
  code         String        @unique
  parentId     String?
  latitude     Float?
  longitude    Float?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parent       Area?         @relation("AreaHierarchy", fields: [parentId], references: [id])
  children     Area[]        @relation("AreaHierarchy")
  castProfiles CastProfile[]

  @@map("areas")
}

model Category {
  id           String        @id @default(cuid())
  name         String
  nameEn       String?
  code         String        @unique
  parentId     String?
  icon         String?
  color        String?
  description  String?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  castProfiles CastProfile[]
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")

  @@map("categories")
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  nameEn       String?
  type         TagType       @default(GENERAL)
  color        String?
  description  String?
  usageCount   Int           @default(0)
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  castProfiles CastProfile[] @relation("CastProfileToTag")

  @@map("tags")
}

model Configuration {
  id          String     @id @default(cuid())
  key         String     @unique
  value       String
  type        ConfigType @default(STRING)
  category    String?
  description String?
  isRequired  Boolean    @default(false)
  isSecret    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("configurations")
}

model Review {
  id         String       @id @default(cuid())
  castId     String
  guestId    String
  authorId   String
  bookingId  String       @unique
  rating     Int
  comment    String?
  isPublic   Boolean      @default(true)
  isReported Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  author     User         @relation(fields: [authorId], references: [id])
  booking    Booking      @relation(fields: [bookingId], references: [id])
  cast       CastProfile  @relation("ReviewCast", fields: [castId], references: [id])
  guest      GuestProfile @relation("ReviewGuest", fields: [guestId], references: [id])

  @@map("reviews")
}

model Payment {
  id                    String           @id @default(cuid())
  bookingId             String           @unique
  payerId               String
  amount                Int
  platformFeeRate       Float            @default(0.05)
  platformFee           Int
  castAmount            Int
  stripePaymentIntentId String?
  stripeCustomerId      String?
  stripeChargeId        String?
  status                PaymentStatus    @default(PENDING)
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  booking               Booking          @relation(fields: [bookingId], references: [id])
  payer                 User             @relation("PaymentPayer", fields: [payerId], references: [id])
  payout                Payout?
  transactionLogs       TransactionLog[]

  @@index([payerId, status])
  @@index([status, createdAt])
  @@index([paidAt])
  @@index([stripeCustomerId])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

model Payout {
  id               String           @id @default(cuid())
  paymentId        String           @unique
  castId           String
  amount           Int
  stripeTransferId String?
  stripeAccountId  String?
  status           PayoutStatus     @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cast             User             @relation("PayoutCast", fields: [castId], references: [id])
  payment          Payment          @relation(fields: [paymentId], references: [id])
  transactionLogs  TransactionLog[]

  @@map("payouts")
}

model TransactionLog {
  id           String            @id @default(cuid())
  paymentId    String?
  payoutId     String?
  action       TransactionAction
  status       String
  amount       Int?
  description  String?
  externalId   String?
  externalData Json?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime          @default(now())
  payment      Payment?          @relation(fields: [paymentId], references: [id])
  payout       Payout?           @relation(fields: [payoutId], references: [id])

  @@map("transaction_logs")
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  title       String
  body        String
  data        Json?
  type        NotificationType
  channel     NotificationChannel
  priority    NotificationPriority @default(MEDIUM)
  isRead      Boolean              @default(false)
  readAt      DateTime?
  isDelivered Boolean              @default(false)
  deliveredAt DateTime?
  relatedId   String?
  relatedType String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationSetting {
  id               String           @id @default(cuid())
  userId           String
  notificationType NotificationType
  pushEnabled      Boolean          @default(true)
  emailEnabled     Boolean          @default(true)
  smsEnabled       Boolean          @default(false)
  quietHoursStart  String?
  quietHoursEnd    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@map("notification_settings")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  level       LogLevel @default(INFO)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  deviceInfo Json?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Favorite {
  id        String      @id @default(cuid())
  guestId   String
  castId    String
  createdAt DateTime    @default(now())
  cast      CastProfile @relation(fields: [castId], references: [id], onDelete: Cascade)
  guest     User        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, castId])
  @@map("favorites")
}

model File {
  id           String       @id @default(cuid())
  fileName     String
  fileType     String
  fileSize     Int
  fileKey      String       @unique
  category     FileCategory
  isPublic     Boolean      @default(false)
  status       FileStatus   @default(PENDING)
  uploadedBy   String
  thumbnailKey String?
  hasThumbnail Boolean      @default(false)
  uploadedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("files")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String?
  filters   Json?
  name      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_histories")
}

model Report {
  id          String       @id @default(cuid())
  type        ReportType
  format      ReportFormat @default(JSON)
  dateRange   Json
  generatedBy String
  data        Json
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [generatedBy], references: [id])

  @@map("reports")
}

model PointTransaction {
  id              String               @id @default(cuid())
  userId          String
  points          Int
  transactionType PointTransactionKind
  amount          Int?
  referenceId     String?
  referenceType   String?
  description     String?
  createdAt       DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([transactionType])
  @@map("point_transactions")
}

model PaymentMethod {
  id                 String              @id @default(cuid())
  userId             String
  stripeMethodId     String              @unique
  type               PaymentMethodKind
  card               Json?
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[]

  @@index([userId])
  @@map("payment_methods")
}

model BankAccount {
  id                 String              @id @default(cuid())
  castId             String
  bankName           String
  branchName         String
  accountType        BankAccountKind
  accountNumber      String
  accountHolderName  String
  isPrimary          Boolean             @default(false)
  isVerified         Boolean             @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [castId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[]

  @@index([castId])
  @@map("bank_accounts")
}

model WithdrawalRequest {
  id              String                  @id @default(cuid())
  castId          String
  bankAccountId   String
  paymentMethodId String?
  amount          Int
  fee             Int                     @default(0)
  netAmount       Int
  status          WithdrawalRequestStatus @default(PENDING)
  requestedAt     DateTime                @default(now())
  processedAt     DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  notes           String?
  bankAccount     BankAccount             @relation(fields: [bankAccountId], references: [id])
  cast            User                    @relation(fields: [castId], references: [id])
  paymentMethod   PaymentMethod?          @relation(fields: [paymentMethodId], references: [id])

  @@index([castId, status])
  @@index([status, requestedAt])
  @@map("withdrawal_requests")
}

model News {
  id          String              @id @default(cuid())
  title       String
  content     String
  category    NewsTopicCategory
  importance  NewsImportanceLevel @default(NORMAL)
  imageUrl    String?
  isPublished Boolean             @default(false)
  publishedAt DateTime?
  viewCount   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  readStatus  NewsReadStatus[]

  @@index([category, isPublished])
  @@index([importance, publishedAt])
  @@map("news")
}

model NewsReadStatus {
  id     String   @id @default(cuid())
  newsId String
  userId String
  readAt DateTime @default(now())
  news   News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@map("news_read_status")
}

model HelpArticle {
  id           String              @id @default(cuid())
  title        String
  content      String
  category     HelpArticleCategory
  tags         String[]
  sortOrder    Int                 @default(0)
  isPublished  Boolean             @default(false)
  viewCount    Int                 @default(0)
  helpfulCount Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  ratings      HelpArticleRating[]

  @@index([category, isPublished])
  @@index([tags])
  @@map("help_articles")
}

model HelpArticleRating {
  id        String      @id @default(cuid())
  articleId String
  userId    String
  isHelpful Boolean
  comment   String?
  createdAt DateTime    @default(now())
  article   HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@map("help_article_ratings")
}

model Inquiry {
  id          String               @id @default(cuid())
  userId      String
  category    InquiryTopicCategory
  subject     String
  message     String
  attachments Json?
  status      InquiryRequestStatus @default(PENDING)
  priority    InquiryPriorityLevel @default(NORMAL)
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, priority])
  @@map("inquiries")
}

model Bank {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  nameKana  String?
  nameEn    String?
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  branches  BankBranch[]

  @@map("banks")
}

model BankBranch {
  id        String   @id @default(cuid())
  bankId    String
  code      String
  name      String
  nameKana  String?
  nameEn    String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bank      Bank     @relation(fields: [bankId], references: [id])

  @@unique([bankId, code])
  @@map("bank_branches")
}

model Skill {
  id          String             @id @default(cuid())
  name        String             @unique
  nameEn      String?
  category    SkillTopicCategory
  description String?
  iconUrl     String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("skills")
}

model ProfileView {
  id       String   @id @default(cuid())
  viewerId String
  viewedId String
  viewedAt DateTime @default(now())
  viewed   User     @relation("ProfileViewViewed", fields: [viewedId], references: [id], onDelete: Cascade)
  viewer   User     @relation("ProfileViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId, viewedAt])
  @@index([viewedId, viewedAt])
  @@index([viewerId, viewedAt])
  @@map("profile_views")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserReport {
  id           String           @id @default(cuid())
  reporterId   String
  reportedId   String
  reason       UserReportReason
  description  String?
  evidenceUrls String[]
  status       UserReportStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reported     User             @relation("UserReportReported", fields: [reportedId], references: [id])
  reporter     User             @relation("UserReportReporter", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([reportedId])
  @@index([status, createdAt])
  @@map("user_reports")
}

model IdVerification {
  id            String               @id @default(cuid())
  userId        String
  documentType  IdDocumentType
  documentUrls  String[]
  extractedData Json?
  status        IdVerificationStatus @default(PENDING)
  submittedAt   DateTime             @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewerNotes String?
  failureReason String?
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("id_verifications")
}

model PrivacySetting {
  id                  String   @id @default(cuid())
  userId              String   @unique
  showFootprints      Boolean  @default(true)
  allowSearch         Boolean  @default(true)
  showOnlineStatus    Boolean  @default(true)
  allowDirectMessages Boolean  @default(true)
  showLastActiveTime  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model ScheduleProposal {
  id               String                 @id @default(cuid())
  conversationId   String
  proposerId       String
  proposedDateTime DateTime
  durationMinutes  Int
  message          String?
  status           ScheduleProposalStatus @default(PENDING)
  respondedAt      DateTime?
  createdAt        DateTime               @default(now())
  conversation     Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposer         User                   @relation(fields: [proposerId], references: [id])

  @@index([conversationId, status])
  @@index([proposerId])
  @@map("schedule_proposals")
}

model PinnedThread {
  id             String       @id @default(cuid())
  conversationId String
  messageId      String
  pinnedBy       String
  pinnedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [pinnedBy], references: [id])

  @@unique([conversationId, messageId])
  @@index([conversationId])
  @@map("pinned_threads")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model NotificationTemplate {
  id        String           @id @default(cuid())
  name      String           @unique
  type      NotificationType
  title     String
  body      String
  variables String[]
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("notification_templates")
}

model ScheduledNotification {
  id            String                      @id @default(cuid())
  userId        String
  templateId    String?
  title         String
  body          String
  data          Json?
  scheduledFor  DateTime
  status        ScheduledNotificationStatus @default(PENDING)
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime                    @default(now())
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
  @@map("scheduled_notifications")
}

model SecurityLog {
  id          String         @id @default(cuid())
  userId      String?
  action      SecurityAction
  entity      String?
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  severity    LogSeverity    @default(INFO)
  createdAt   DateTime       @default(now())
  user        User?          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([severity, createdAt])
  @@map("security_logs")
}

