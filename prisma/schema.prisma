generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  userType             UserType              @default(GUEST)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  birthDate            DateTime?
  city                 String?
  image                String?
  isVerified           Boolean               @default(false)
  name                 String?
  phoneNumber          String?
  points               Int                   @default(0)
  prefecture           String?
  selfIntro            String?
  tags                 String[]
  accounts             Account[]
  sessions             Session[]
  activityLogs         ActivityLog[]
  castBookings         Booking[]             @relation("BookingCast")
  guestBookings        Booking[]             @relation("BookingGuest")
  castProfile          CastProfile?
  deviceTokens         DeviceToken[]
  favorites            Favorite[]
  files                File[]
  guestProfile         GuestProfile?
  messageReadStatus    MessageReadStatus[]
  sentMessages         Message[]             @relation("MessageSender")
  notificationSettings NotificationSetting[]
  notifications        Notification[]
  payments             Payment[]             @relation("PaymentPayer")
  payouts              Payout[]              @relation("PayoutCast")
  reports              Report[]
  reviews              Review[]
  searchHistory        SearchHistory[]
  conversations        Conversation[]        @relation("ConversationToUser")

  @@index([email])
  @@index([userType])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CastProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  displayName  String
  bio          String?
  avatar       String?
  coverImage   String?
  hourlyRate   Int
  availability Json
  specialties  String[]
  experience   String?
  portfolio    Json?
  isActive     Boolean    @default(true)
  isVerified   Boolean    @default(false)
  areaId       String?
  categoryId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  area         Area?      @relation(fields: [areaId], references: [id])
  category     Category?  @relation(fields: [categoryId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites    Favorite[]
  reviews      Review[]   @relation("ReviewCast")
  tags         Tag[]      @relation("CastProfileToTag")

  @@index([isActive, isVerified])
  @@index([hourlyRate])
  @@index([areaId, categoryId])
  @@index([displayName])
  @@index([createdAt])
  @@map("cast_profiles")
}

model GuestProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  preferences Json?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews     Review[] @relation("ReviewGuest")

  @@map("guest_profiles")
}

model Booking {
  id              String        @id @default(cuid())
  guestId         String
  castId          String
  title           String
  description     String?
  serviceType     String
  startDateTime   DateTime
  endDateTime     DateTime
  durationMinutes Int
  hourlyRate      Int
  totalAmount     Int
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cast            User          @relation("BookingCast", fields: [castId], references: [id])
  guest           User          @relation("BookingGuest", fields: [guestId], references: [id])
  conversation    Conversation?
  payment         Payment?
  review          Review?

  @@index([guestId, status])
  @@index([castId, status])
  @@index([startDateTime, endDateTime])
  @@index([status, createdAt])
  @@map("bookings")
}

model Conversation {
  id           String    @id @default(cuid())
  bookingId    String?   @unique
  title        String?
  isGroup      Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  messages     Message[]
  participants User[]    @relation("ConversationToUser")

  @@map("conversations")
}

model Message {
  id                String              @id @default(cuid())
  conversationId    String
  senderId          String
  content           String?
  messageType       MessageType         @default(TEXT)
  isRead            Boolean             @default(false)
  isDeleted         Boolean             @default(false)
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  attachments       MessageAttachment[]
  messageReadStatus MessageReadStatus[]
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User                @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([isRead])
  @@index([messageType])
  @@map("messages")
}

model MessageAttachment {
  id           String   @id @default(cuid())
  messageId    String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageReadStatus {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@map("message_read_status")
}

model Area {
  id           String        @id @default(cuid())
  name         String
  nameEn       String?
  code         String        @unique
  parentId     String?
  latitude     Float?
  longitude    Float?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parent       Area?         @relation("AreaHierarchy", fields: [parentId], references: [id])
  children     Area[]        @relation("AreaHierarchy")
  castProfiles CastProfile[]

  @@map("areas")
}

model Category {
  id           String        @id @default(cuid())
  name         String
  nameEn       String?
  code         String        @unique
  parentId     String?
  icon         String?
  color        String?
  description  String?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  castProfiles CastProfile[]
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")

  @@map("categories")
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  nameEn       String?
  type         TagType       @default(GENERAL)
  color        String?
  description  String?
  usageCount   Int           @default(0)
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  castProfiles CastProfile[] @relation("CastProfileToTag")

  @@map("tags")
}

model Configuration {
  id          String     @id @default(cuid())
  key         String     @unique
  value       String
  type        ConfigType @default(STRING)
  category    String?
  description String?
  isRequired  Boolean    @default(false)
  isSecret    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("configurations")
}

model Review {
  id         String       @id @default(cuid())
  castId     String
  guestId    String
  authorId   String
  bookingId  String       @unique
  rating     Int
  comment    String?
  isPublic   Boolean      @default(true)
  isReported Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  author     User         @relation(fields: [authorId], references: [id])
  booking    Booking      @relation(fields: [bookingId], references: [id])
  cast       CastProfile  @relation("ReviewCast", fields: [castId], references: [id])
  guest      GuestProfile @relation("ReviewGuest", fields: [guestId], references: [id])

  @@map("reviews")
}

model Payment {
  id                    String           @id @default(cuid())
  bookingId             String           @unique
  payerId               String
  amount                Int
  platformFeeRate       Float            @default(0.05)
  platformFee           Int
  castAmount            Int
  stripePaymentIntentId String?
  stripeCustomerId      String?
  stripeChargeId        String?
  status                PaymentStatus    @default(PENDING)
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  booking               Booking          @relation(fields: [bookingId], references: [id])
  payer                 User             @relation("PaymentPayer", fields: [payerId], references: [id])
  payout                Payout?
  transactionLogs       TransactionLog[]

  @@index([payerId, status])
  @@index([status, createdAt])
  @@index([paidAt])
  @@index([stripeCustomerId])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

model Payout {
  id               String           @id @default(cuid())
  paymentId        String           @unique
  castId           String
  amount           Int
  stripeTransferId String?
  stripeAccountId  String?
  status           PayoutStatus     @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cast             User             @relation("PayoutCast", fields: [castId], references: [id])
  payment          Payment          @relation(fields: [paymentId], references: [id])
  transactionLogs  TransactionLog[]

  @@map("payouts")
}

model TransactionLog {
  id           String            @id @default(cuid())
  paymentId    String?
  payoutId     String?
  action       TransactionAction
  status       String
  amount       Int?
  description  String?
  externalId   String?
  externalData Json?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime          @default(now())
  payment      Payment?          @relation(fields: [paymentId], references: [id])
  payout       Payout?           @relation(fields: [payoutId], references: [id])

  @@map("transaction_logs")
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  title       String
  body        String
  data        Json?
  type        NotificationType
  channel     NotificationChannel
  priority    NotificationPriority @default(MEDIUM)
  isRead      Boolean              @default(false)
  readAt      DateTime?
  isDelivered Boolean              @default(false)
  deliveredAt DateTime?
  relatedId   String?
  relatedType String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationSetting {
  id               String           @id @default(cuid())
  userId           String
  notificationType NotificationType
  pushEnabled      Boolean          @default(true)
  emailEnabled     Boolean          @default(true)
  smsEnabled       Boolean          @default(false)
  quietHoursStart  String?
  quietHoursEnd    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@map("notification_settings")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  level       LogLevel @default(INFO)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  deviceInfo Json?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Favorite {
  id        String      @id @default(cuid())
  guestId   String
  castId    String
  createdAt DateTime    @default(now())
  cast      CastProfile @relation(fields: [castId], references: [id], onDelete: Cascade)
  guest     User        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, castId])
  @@map("favorites")
}

model File {
  id           String       @id @default(cuid())
  fileName     String
  fileType     String
  fileSize     Int
  fileKey      String       @unique
  category     FileCategory
  isPublic     Boolean      @default(false)
  status       FileStatus   @default(PENDING)
  uploadedBy   String
  thumbnailKey String?
  hasThumbnail Boolean      @default(false)
  uploadedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("files")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String?
  filters   Json?
  name      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_histories")
}

model Report {
  id          String       @id @default(cuid())
  type        ReportType
  format      ReportFormat @default(JSON)
  dateRange   Json
  generatedBy String
  data        Json
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [generatedBy], references: [id])

  @@map("reports")
}

enum UserType {
  GUEST
  CAST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum TagType {
  GENERAL
  SKILL
  SPECIALTY
  PERSONALITY
  EXPERIENCE
}

enum ConfigType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionAction {
  PAYMENT_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  PAYOUT_CREATED
  PAYOUT_COMPLETED
  PAYOUT_FAILED
  REFUND_CREATED
  REFUND_COMPLETED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  MESSAGE_RECEIVED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  PAYOUT_AVAILABLE
  SYSTEM_UPDATE
  PROMOTIONAL
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum FileCategory {
  PROFILE
  SERVICE
  MESSAGE
  DOCUMENT
}

enum FileStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReportType {
  REVENUE
  USER_ACTIVITY
  BOOKING_ANALYSIS
}

enum ReportFormat {
  JSON
  CSV
  PDF
}
